+}
+
+bool PageTableWalker::pq_contains(int64_t vpn) const
+{
+  return std::any_of(std::begin(sbfp_pq), std::end(sbfp_pq), [vpn](const auto& e) { return e.vpn == vpn; });
+}
+
+bool PageTableWalker::pq_insert(int64_t vpn, int dist_idx)
+{
+  if (pq_contains(vpn))
+    return false;
+  const champsim::page_number vpage{champsim::address{static_cast<uint64_t>(vpn) << LOG2_PAGE_SIZE}};
+  if (!vmem->is_mapped(0, vpage))
+    return false;
+  auto [ppage, penalty] = vmem->va_to_pa(0, vpage); // already mapped: no allocation, no fault
+  (void)penalty;
+  if (std::size(sbfp_pq) == PQ_SIZE)
+    sbfp_pq.pop_front(); // FIFO (replacement policy not stated in the paper)
+  sbfp_pq.push_back({vpn, ppage, dist_idx});
+  ++proto_pq_inserts;
+  return true;
+}
+
+void PageTableWalker::complete_from_pq(const request_type& pkt, channel_type* ul, champsim::page_number ppage)
+{
+  mshr_type m{pkt, 0};
+  m.v_address = pkt.address;
+  m.data = champsim::waitable{champsim::address{ppage}, current_time + (warmup ? champsim::chrono::clock::duration{} : HIT_LATENCY)};
+  if (pkt.response_requested)
+    m.to_return = {&ul->returned};
+  completed.push_back(m);
+}
+
+void PageTableWalker::complete_free_prefetch(const request_type& pkt, channel_type* ul)
+{
+  ++proto_free_walks;
+  // The neighbouring PTE sits in the cache line fetched by the triggering walk, so no memory access is made.
+  // va_to_pa also allocates a physical page if the neighbour was never touched (side effect of the simulator).
+  auto [ppage, penalty] = vmem->va_to_pa(pkt.cpu, champsim::page_number{pkt.address});
+  (void)penalty;
+  mshr_type m{pkt, 0};
+  m.v_address = pkt.address;
+  m.data = champsim::waitable{champsim::address{ppage}, current_time + (warmup ? champsim::chrono::clock::duration{} : HIT_LATENCY)};
+  if (pkt.response_requested)
+    m.to_return = {&ul->returned};
+  completed.push_back(m);
 }
 
