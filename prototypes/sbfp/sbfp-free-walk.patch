+
+void PageTableWalker::complete_free_prefetch(const request_type& pkt, channel_type* ul)
+{
+  ++proto_free_walks;
+  // The neighbouring PTE sits in the cache line fetched by the triggering walk, so no memory access is made.
+  // va_to_pa also allocates a physical page if the neighbour was never touched (side effect of the simulator).
+  auto [ppage, penalty] = vmem->va_to_pa(pkt.cpu, champsim::page_number{pkt.address});
+  (void)penalty;
+  mshr_type m{pkt, 0};
+  m.v_address = pkt.address;
+  m.data = champsim::waitable{champsim::address{ppage}, current_time + (warmup ? champsim::chrono::clock::duration{} : HIT_LATENCY)};
+  if (pkt.response_requested)
+    m.to_return = {&ul->returned};
+  completed.push_back(m);
 }
 
