+#ifndef SBFP_HOOKS_H
+#define SBFP_HOOKS_H
+
+#include <cstdint>
+#include <functional>
+
+// Glue between the SBFP prefetcher module and the page-table walker (the walker owns the 64-entry prefetch queue).
+// Modules cannot include ptw.h, so the walker fills in the first two functions and the module fills in the last two.
+// One STLB and one walker are assumed.
+struct sbfp_hooks {
+  static inline std::function<bool(int64_t, int)> pq_insert;  // (virtual page, free-distance index) -> inserted; set by the walker
+  static inline std::function<bool(int64_t)> pq_contains;     // set by the walker
+  static inline std::function<void(int64_t)> walk_done;       // called by the walker when a page walk finishes; set by the module
+  static inline std::function<void(int)> pq_hit;              // called by the walker on a PQ hit; set by the module
+};
+
+#endif
